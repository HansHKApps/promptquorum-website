# Public base URL — used to build absolute confirm/unsubscribe links in emails.
NEXT_PUBLIC_BASE_URL=https://www.promptquorum.com

# Resend (transactional email)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# HMAC secret for confirm + unsubscribe tokens (any long random string).
# Generate with: openssl rand -hex 32
TOKEN_SECRET=

# Salt used to one-way hash visitor IPs in the consent audit log.
# Generate with: openssl rand -hex 32
# REQUIRED in production. Dev falls back to empty salt with a console warning.
IP_HASH_SALT=

# Upstash Redis — used for rate limiting and consent/unsubscribe audit log.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner-only export of the anonymous cloud-app alternatives search log (GET /api/alternatives).
ALTERNATIVES_LOG_TOKEN=

# --- Ask Hans (German AI chat opened from the search bar) --------------------------------------
# Master switch. Off unless exactly "true". The browser part is baked in at BUILD time, so after
# changing it a new deployment is needed; the API route checks it at runtime too.
ASK_HANS_ENABLED=false
# Anthropic API key (server only, never NEXT_PUBLIC_, never committed). Required when enabled.
ANTHROPIC_API_KEY=
# Model for the chat. Default claude-haiku-5-5; switch to claude-sonnet-5-5 for better answers at higher cost.
ASK_HANS_MODEL=claude-haiku-5-5
# Also used by Ask Hans: UPSTASH_REDIS_REST_URL/TOKEN (rate limit + anonymous counters) and IP_HASH_SALT (hashes the rate-limit key).

# Ask Hans button-wording experiment (askhans-cta-v1). See docs/askhans-cta-experiment.md.
# ON: the three wordings are assigned 1/3 each per browser session and the funnel counters run (needs NEXT_PUBLIC_ASK_HANS_ENABLED=true).
NEXT_PUBLIC_ASK_HANS_CTA_EXPERIMENT=false
# After the experiment: switch it off and set the winner (A|B|C) to show that wording to everybody. Empty = original "Ask Hans".
NEXT_PUBLIC_ASK_HANS_CTA_WINNER=
# Access key for the internal dashboard /askhans/experiment?key=... (unset = the page is a 404).
ASK_HANS_EXPERIMENT_KEY=
